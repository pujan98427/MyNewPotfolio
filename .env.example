# Canonical public HTTPS origin. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://YOUR-PRODUCTION-DOMAIN

# Leave blank until a real Google AdSense publisher ID has been assigned.
# Expected format: pub- followed by the 16 digits supplied by AdSense.
GOOGLE_ADSENSE_PUBLISHER_ID=

# Google Search Console HTML-tag verification token only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend contact delivery. Keep the API key and recipient server-only.
# Use "disabled" for local development and automated tests. Production must
# explicitly use "live"; there is no automatic recipient redirection.
CONTACT_DELIVERY_MODE=disabled
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=

# Optional Cloudflare Turnstile configuration. The site key is intentionally public;
# TURNSTILE_SECRET_KEY must remain server-only. Leave both blank while disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set true when production must fail closed unless Turnstile verifies the request.
TURNSTILE_REQUIRED=
# Explicit local-only bypass. This flag is ignored outside development.
TURNSTILE_DEV_BYPASS=
