# Canonical public HTTPS origin. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://poojanchapagain.com.np

# Leave blank until a real Google AdSense publisher ID has been assigned.
# Expected format: pub- followed by the 16 digits supplied by AdSense.
GOOGLE_ADSENSE_PUBLISHER_ID=

# Google Search Console HTML-tag verification token only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend contact delivery. Use a sender on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pujan Chapagain <contact@YOUR-VERIFIED-DOMAIN>
CONTACT_TO_EMAIL=chapagain.pujan@gmail.com
