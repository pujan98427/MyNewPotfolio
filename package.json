{
  "name": "pujan-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components data lib types next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tests/web-doctor.unit.mjs && node tests/contact-validation.test.mjs && node tests/contact-api.mock.mjs && node tests/contact-resend.mock.mjs",
    "test:headings": "node tests/headings.integration.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/web-doctor.test.mjs",
    "test:status": "node tests/http-status.integration.mjs",
    "audit:links": "node scripts/audit-internal-links.mjs",
    "audit:links:production": "npm run build && npm run audit:links",
    "audit:performance": "node scripts/audit-performance.mjs",
    "audit:performance:production": "npm run build && npm run audit:performance"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
